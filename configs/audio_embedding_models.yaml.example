transcript_model:
  name: sentence-transformers/sentence-t5-base
  local_snapshot: .cache/huggingface/sentence-t5-base
  local_files_only: true
  normalize_embeddings: true
acoustic_model:
  name: laion/clap-htsat-unfused
  revision: refs/pr/3
  resolved_snapshot: .cache/huggingface/clap-htsat-unfused
  weight_format: safetensors
  local_files_only: true
  sample_rate: 48000
  maximum_chunk_duration_sec: 10.0
  pooling: normalized_mean_of_chunk_embeddings
device: cuda
dtype_on_disk: float32
mvp_cases_path: data/manifests/mvp_cases_6.json
dataset_root: data/EgoSound
audio_index_root: outputs/audio_index
