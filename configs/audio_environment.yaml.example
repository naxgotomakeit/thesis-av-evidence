environment:
  name: thesis_av
  python: "3.10"
  platform: Windows_or_Linux
packages:
  torch: "install a CUDA-compatible build when GPU execution is required"
  numpy: required
  scipy: required
  soundfile: required
  openai-whisper: required_for_local_fallback
models:
  whisper:
    name: small multilingual
    cache_path: .cache/whisper/small.pt
notes:
  - Record exact package and hardware versions for each benchmark run.
  - Model weights and download caches are not included in Git.
