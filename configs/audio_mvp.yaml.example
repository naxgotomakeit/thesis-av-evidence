sample_rate: 16000
vad_threshold: 0.50
minimum_speech_duration_ms: 250
speech_merge_gap_sec: 0.50
speech_pad_ms: 30
acoustic_window_length_sec: 0.50
acoustic_hop_length_sec: 0.10
smoothing_window_sec: 0.70
boundary_threshold_method: median_mad
boundary_mad_multiplier: 2.75
minimum_acoustic_region_duration_sec: 2.0
low_information_rms_quantile: 0.15
whisper_model: small
whisper_device: cuda
whisper_precision: float16
whisper_word_timestamps: true
whisper_cache_dir: .cache/whisper
dataset_root: data/EgoSound
mvp_cases_path: data/manifests/mvp_cases_6.json
output_root: outputs/audio_index
