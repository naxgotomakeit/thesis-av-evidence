top_k:
  visual: 3
  speech: 3
  acoustic: 3
similarity_metric: cosine_similarity
normalize_query_embeddings: true
normalize_index_embeddings: true
device: cuda
encoders:
  visual:
    name: openai_clip_vit_b_32
    model_name: ViT-B/32
    cache_path: .cache/clip/ViT-B-32.pt
  speech:
    name: sentence-transformers/sentence-t5-base
    cache_path: .cache/huggingface/sentence-t5-base
  acoustic:
    name: laion/clap-htsat-unfused
    revision: refs/pr/3
    cache_path: .cache/huggingface/clap-htsat-unfused
frozen_inputs:
  cases: data/manifests/mvp_cases_6.json
  visual_index: outputs/visual_index/{video_id}
  speech_index: outputs/audio_index/{video_id}
  acoustic_index: outputs/audio_index/{video_id}
output_path: outputs/retrieval
