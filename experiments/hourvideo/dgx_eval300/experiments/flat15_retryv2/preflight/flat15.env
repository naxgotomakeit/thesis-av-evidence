# Flat-15 formal configuration. Derived from accepted Flat-30 experiment_config.json.
EXPERIMENT_NAME=hourvideo_eval300_flat15_v1
VISUAL_RETRIEVE_TOPK=15
SEMANTIC_RETRIEVE_TOPK=40
SEMANTIC_RETRIEVE_MIX=embed
RETRIEVE_EMBED_WEIGHT=0.8
RETRIEVE_BM25_WEIGHT=0.2
RETRIEVE_MIN_TIME_GAP_SEC=15.0
VISUAL_RETRIEVE_SUMMARY_ENABLED=1
RETRIEVE_SUMMARY_ENABLED=1
RETRIEVE_SUMMARY_MAX_SPANS=100
AGENT_LLM_BACKEND=api
AGENT_API_USE_MESSAGES=0
AGENT_LLM_MAX_TOKENS=2048
AGENT_LLM_TEMPERATURE=0.0
AGENT_LLM_TIMEOUT=300
INSPECT_MAX_LONG_EDGE=1280
INSPECT_VLM_MAX_TOKENS=4096
INSPECT_VLM_TEMPERATURE=0.1
INSPECT_MAX_TOTAL_IMAGES=64
INSPECT_FPS=2
VISUAL_INSPECT_MAX_LONG_EDGE=1280
VISUAL_INSPECT_DYNAMIC_MAX_LONG_EDGE=1
VISUAL_INSPECT_TOTAL_PIXELS=20971520
VISUAL_INSPECT_MIN_PIXELS=12544
VISUAL_INSPECT_EDGE_MULTIPLE=32
MLLM_MAX_TOKENS=4096
MLLM_TIMEOUT=300
MLLM_RETRY_TIMES=3
MLLM_RETRY_DELAY=30
EMBED_RETRY_TIMES=5
EMBED_RETRY_DELAY=30
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-large
MAX_STEPS=16
TASK_TIMEOUT_SEC=1000
CONCURRENCY=1
AGENT_FORCE_LAST_STEP_VISUAL_INSPECT=1
AGENT_ENABLE_LAST_STEP_VISUAL_INSPECT_FALLBACK=1
AGENT_ENABLE_MAX_STEP_VISUAL_INSPECT_FALLBACK=1
AGENT_LAST_STEP_VISUAL_INSPECT_PROMPT_MODE=mcq
AGENT_PARSE_FAILURE_FALLBACK_TO_C=0
USE_VLLM_META_FILE=0
VLLM_NUM_SERVERS=1
# Deliberately unset before service startup.  The frozen smoke_one.sh sets
# VLLM_PORT only after both vLLM services have passed their health checks.
# Exporting it here makes vLLM allocate its internal NCCL/TCPStore ports
# starting at 18082 and can collide with the visual API port 18083.
