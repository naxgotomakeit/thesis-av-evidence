{
  "schema_version": "hourvideo-frame-embeddings-3way-v1",
  "dino_v2": {
    "model": "facebook/dinov2-small",
    "preprocessing_pooling": "existing repository DINOv2FeatureExtractor contract"
  },
  "siglip": {
    "model": "google/siglip-base-patch16-224",
    "preprocessing_pooling": "existing encode_egopolice_frames_siglip contract",
    "offline_cache_required": true
  },
  "c_radio_v4": {
    "model": "c-radio_v4-so400m",
    "implementation": "official NVlabs/RADIO torchhub",
    "adaptor_names": [
      "siglip2-g",
      "dino_v3_7b"
    ],
    "requested_adaptor_alias": "dino_v3",
    "actual_adaptor_name": "dino_v3_7b",
    "output_field": "dino_v3_summary",
    "save_spatial_features": false,
    "batch_size": 1
  },
  "execution": "sequential_separate_process_per_model",
  "shard_unit": "one video",
  "resume": true
}
