{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gens_hybrid_cap16.selector_output.schema.json",
  "title": "Shared cap-16 downstream frame package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "qa_uid", "video_id", "method", "status", "error",
    "selected_frames", "actual_frame_count", "downstream_frame_order",
    "selection_latency_ms", "provenance"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "qa_uid": {"type": "string", "minLength": 1},
    "video_id": {"type": "string", "minLength": 1},
    "method": {"enum": ["uniform_16", "gens_hybrid_cap16", "ours_cap16"]},
    "status": {"enum": ["ok", "candidate_failure", "clip_failure", "gens_failure", "context_overflow", "parser_failure", "gens_no_valid_frames"]},
    "error": {"type": ["object", "null"]},
    "selected_frames": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["downstream_order", "video_id", "timestamp_sec", "frame_index", "source_video_path", "extracted_frame_path", "selection"],
        "properties": {
          "downstream_order": {"type": "integer", "minimum": 0, "maximum": 15},
          "video_id": {"type": "string"},
          "timestamp_sec": {"type": "number", "minimum": 0},
          "frame_index": {"type": "integer", "minimum": 0},
          "source_video_path": {"type": "string"},
          "extracted_frame_path": {"type": "string"},
          "selection": {
            "type": "object",
            "additionalProperties": true,
            "required": ["clip_rank", "clip_score", "gens_input_index", "gens_relevance_score", "gens_span", "gens_response_order"],
            "properties": {
              "clip_rank": {"type": "integer", "minimum": 1, "maximum": 256},
              "clip_score": {"type": "number"},
              "gens_input_index": {"type": "integer", "minimum": 1, "maximum": 256},
              "gens_relevance_score": {"type": "integer", "minimum": 1, "maximum": 5},
              "gens_span": {"type": "string"},
              "gens_response_order": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "actual_frame_count": {"type": "integer", "minimum": 0, "maximum": 16},
    "downstream_frame_order": {"const": "timestamp_sec_asc_then_frame_index_asc"},
    "selection_latency_ms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_extraction", "clip_text", "clip_images", "clip_sort", "gens_preprocess", "gens_generate", "gens_parse", "total"],
      "properties": {
        "candidate_extraction": {"type": "number", "minimum": 0},
        "clip_text": {"type": "number", "minimum": 0},
        "clip_images": {"type": "number", "minimum": 0},
        "clip_sort": {"type": "number", "minimum": 0},
        "gens_preprocess": {"type": "number", "minimum": 0},
        "gens_generate": {"type": "number", "minimum": 0},
        "gens_parse": {"type": "number", "minimum": 0},
        "total": {"type": "number", "minimum": 0}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["profile", "profile_sha256", "query_template_sha256", "query_sha256", "clip", "gens", "candidate_pool", "clip_candidates", "gens_raw_response", "gens_parser", "gens_relevance_order"],
      "properties": {
        "profile": {"const": "gens_hybrid_cap16"},
        "profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "query_template_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "query_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "clip": {"type": "object"},
        "gens": {"type": "object"},
        "candidate_pool": {"type": "array"},
        "clip_candidates": {"type": "array"},
        "gens_raw_response": {"type": ["string", "null"]},
        "gens_parser": {"type": "object"},
        "gens_relevance_order": {"type": "array"}
      }
    }
  }
}
