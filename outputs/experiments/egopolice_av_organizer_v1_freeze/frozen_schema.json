{
  "typed_minimal_selector": {
    "type": "object",
    "additionalProperties": false,
    "required": ["phase_id","selected_visual_ids","selected_audio_ids","av_links","boundary_context_ids","uncertainty_tags"],
    "properties": {
      "phase_id": {"type":"string"},
      "selected_visual_ids": {"type":"array","items":{"type":"string"}},
      "selected_audio_ids": {"type":"array","items":{"type":"string"}},
      "av_links": {
        "type":"array",
        "items":{
          "type":"object",
          "additionalProperties":false,
          "required":["visual_ids","audio_ids","relation","certainty"],
          "properties":{
            "visual_ids":{"type":"array","items":{"type":"string"}},
            "audio_ids":{"type":"array","items":{"type":"string"}},
            "relation":{"type":"string","enum":["supports_interpretation","clarifies_activity","temporally_aligned","contradicts"]},
            "certainty":{"type":"string","enum":["supported","tentative"]}
          }
        }
      },
      "boundary_context_ids":{"type":"array","items":{"type":"string"}},
      "uncertainty_tags":{"type":"array","items":{"type":"string","enum":["speaker_unknown","transcript_unclear","visual_ambiguous","temporal_relation_uncertain","identity_unknown","casualty_assignment_uncertain"]}}
    }
  },
  "phase_presenter": {
    "type":"object",
    "additionalProperties":false,
    "required":["phase_id","start_sec","end_sec","visual_account","audio_account","combined_account","uncertainty"],
    "properties":{
      "phase_id":{"type":"string"},
      "start_sec":{"type":"number"},
      "end_sec":{"type":"number"},
      "visual_account":{"type":"string"},
      "audio_account":{"type":"string"},
      "combined_account":{"type":"string"},
      "uncertainty":{"type":"array","items":{"type":"string"}}
    }
  },
  "global_summary": {
    "type":"object",
    "additionalProperties":false,
    "required":["executive_summary","critical_uncertainty"],
    "properties":{
      "executive_summary":{"type":"string"},
      "critical_uncertainty":{"type":"array","items":{"type":"string"}}
    }
  },
  "typed_sanitization": {
    "modality_source":"canonical node registry, never ID-name inference",
    "membership_source":"deterministic phase assignment",
    "allowed_actions":["canonical_modality_reroute","context_membership_reroute","stable_deduplication","invalid_link_removal"],
    "forbidden_actions":["semantic evidence selection","new AV link creation","relation rewriting","certainty rewriting","budget trimming"]
  }
}
